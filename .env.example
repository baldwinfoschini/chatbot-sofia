# Copia este archivo como .env y ajusta los valores. El archivo .env NO se sube a GitHub.

# ── PASO 2 · Modelo de lenguaje local (Ollama) ─────────────────────────────
OLLAMA_BASE_URL=http://127.0.0.1:11434
LLM_MODEL=phi3
# Modelo de embeddings: las versiones recientes de Ollama solo generan embeddings con modelos especializados
# (phi3 responde "does not support embeddings"). Descárgalo con: ollama pull nomic-embed-text
EMBEDDING_MODEL=nomic-embed-text
# Temperatura baja = respuestas más fieles a los documentos (menos creatividad, menos alucinaciones)
LLM_TEMPERATURE=0.2
LLM_TOP_P=0.9
# Ventana de contexto (tokens) y longitud máxima de la respuesta
LLM_NUM_CTX=4096
LLM_NUM_PREDICT=512

# ── PASO 1 · Base vectorial Chroma (persistente) ───────────────────────────
CHROMA_DIR=chroma_db
CHROMA_COLLECTION=aca2_educacion_rag
TOP_K=4
CHUNK_SIZE=700
CHUNK_OVERLAP=100
# Relevancia mínima (0-1) para enviar la pregunta al LLM; 0 = desactivado. Calibrar en el paso 5.
UMBRAL_RELEVANCIA=0.0
MAX_TURNOS_HISTORIAL=3
# true = indexa además una ficha de texto por cada uno de los 480 estudiantes
INCLUIR_FICHAS=false

# ── Monitoreo ──────────────────────────────────────────────────────────────
# Carpeta donde se guarda el registro de consultas (logs/consultas.jsonl)
LOG_DIR=logs

# ── Si en el futuro usas una API en la nube, la clave va aquí (nunca en el código) ──
# GOOGLE_API_KEY=
